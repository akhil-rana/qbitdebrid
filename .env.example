# Your private TorBox API key. Required.
TORBOX_API_KEY=your_api_key_here

# Base URL for TorBox API. Do not change.
TORBOX_API_BASE_URL=https://api.torbox.app/v1

# The hostname or IP address of your qBittorrent WebUI.
QBIT_HOST=127.0.0.1

# The port of your qBittorrent WebUI.
QBIT_PORT=8080

# The login username for your qBittorrent WebUI. Leave blank if none.
QBIT_USERNAME=

# The login password for your qBittorrent WebUI. Leave blank if none.
QBIT_PASSWORD=

# How frequently (in seconds) the daemon polls qBittorrent for new torrents.
QBIT_POLL_INTERVAL=3

# The IP address/host of this proxy. Must be reachable by your qBittorrent client.
PROXY_HOST=127.0.0.1

# The port the Web Seed proxy listens on.
PROXY_PORT=8593

# Max concurrent CDN connections. Do not change (must stay at 1).
PROXY_MAX_CONNECTIONS=1

# Size (in bytes) of each raw HTTP chunk read from the CDN.
PROXY_CHUNK_SIZE=4194304

# Global RAM prefetch buffer size (in MB). 256 is recommended.
# Use 512 for multi-gigabit connections, but it will increase RAM usage.
PROXY_PREFETCH_BUFFER_MB=256

# Category tag used to identify and isolate torrents managed by this proxy.
TORRENT_PROCESS_TAG=qbitdebrid

# Logging level. Allowed: DEBUG, INFO, WARNING, ERROR, CRITICAL.
LOG_LEVEL=INFO

# Log layout format. Allowed: console (human-readable) or json.
LOG_FORMAT=console
