TORBOX_API_KEY=your_api_key_here
TORBOX_API_BASE_URL=https://api.torbox.app/v1
TORBOX_CACHE_THRESHOLD=0.95

QBIT_HOST=127.0.0.1
QBIT_PORT=8080
QBIT_USERNAME=
QBIT_PASSWORD=
QBIT_POLL_INTERVAL=3

PROXY_HOST=127.0.0.1
PROXY_PORT=8888
PROXY_MAX_CONNECTIONS=1
PROXY_CHUNK_SIZE=65536

LOG_LEVEL=INFO
LOG_FORMAT=json

ENABLE_JIT_PREFETCH=true
ENABLE_ZIP_EXTRACTION=false
CLOUDFLARE_RESILIENCE_ENABLED=true
CLOUDFLARE_RETRY_ATTEMPTS=3
CLOUDFLARE_RETRY_BACKOFF=2.0
